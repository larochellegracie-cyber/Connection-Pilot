# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# Development Tools
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# MySQL. Local: DB_*. On Railway use the MYSQL* variables (MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE) referenced from the MySQL service.
# DB_SSL=false only if the database does not support SSL.
# See DEPLOY_RAILWAY.md and run `npm run check:env`.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=user_<random>
# DB_PASS=<generated_password>
# DB_NAME=<schema_name>

# External APIs (when needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# FIRECRAWL_API_KEY=fc-...   (website learning: logo, brand colours, hours, services, contact details; about 5 credits per website)

# Email (Resend). Without RESEND_API_KEY, emails are printed to the terminal
# in development. In production a missing key is an error.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=noreply@connectionpilot.net

# Authentication (when needed)
# BETTER_AUTH_SECRET=<random 32+ bytes>
# BETTER_AUTH_URL=http://localhost:5173
# BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.com

# Optional: a persistent folder (e.g. a Railway volume mount) where uploaded originals are kept.
# Without it, uploads still work: Pilot keeps the extracted text and findings in the database.
# PILOT_DOCUMENT_STORAGE_DIR=/data/pilot-documents

# Persistent folder for marketing pictures, videos and uploaded photos. Without it they live in a temporary folder and are lost on restart.
# Locally use an absolute path to a git-ignored folder, e.g. /path/to/Connection_Pilot/media
# MARKETING_MEDIA_DIR=

# Code-written video (optional, free): Pilot writes the scene sequence as a small Python program and draws it in a sandbox.
# Setup (once): python3 -m venv .venv-codevideo && .venv-codevideo/bin/pip install pillow numpy
# Needs macOS (sandbox-exec) or Linux with bubblewrap (bwrap); anywhere else Pilot uses its standard renderer.
# PILOT_CODE_VIDEO=primary   # primary (default: custom Python+FFmpeg code is the main path for every creative, styled, reference-based or higher-quality video and post; plain simple requests keep the templates) | auto (only when asked for custom animation, creative, or the templates do not fit) | request (only when asked) | default (every free video) | off (never)
# For those requests Pilot first invents the whole video (scenes, pacing, visuals) and draws every scene itself: no service cards, lists or "book now" closing. If that fails it says so and uses the scene library, then the standard video.
# A fully custom video chooses its own colour mood for the subject (the business's brand colour stays as the accent) and is drawn with simulated depth: a lit studio set, lit 3D-style shapes, soft shadows, drifting lights and slow camera moves. It can use ready-made props (cake, cupcake, coffee, gift, house, tree, sun, water, wrench). It is slow (several minutes) and uses more CPU than the standard video.
# A custom video that fails is tried once as an arrangement of the scene library, then as the standard video, and the owner is told.
# PILOT_CODE_VIDEO_PYTHON=/path/to/python
# PILOT_CODE_VIDEO_STYLE=open   # open (default: the model may draw its own scenes with the canvas) | library (only the ready-made scene types)

# Generated artwork (free, drawn on the server): when none of the owner's photos fits a post or video, Pilot draws brand-coloured artwork for the subject
# and keeps it in Photos labelled "Made by Pilot". Set to off to use only the plain branded graphic instead.
# PILOT_GENERATED_ART=on   # on (default) | off

# Realistic generated images (optional, costs money): when none of the owner's photos fits a post or video, Pilot can generate a realistic picture of the subject
# with OpenAI's image model (gpt-image-1-mini, medium quality, 1024x1536), using the same OPENAI_API_KEY Pilot already writes with. About 1-2 US cents per image
# (see OpenAI's pricing). Each subject is generated once and reused. No text, people or logos are asked for, and every image is labelled "AI image" in Photos.
# If it fails or the daily cap is reached, Pilot uses the free artwork (PILOT_GENERATED_ART) or the plain branded graphic instead.
# PILOT_REALISTIC_IMAGES=off            # off (default) | on
# PILOT_REALISTIC_IMAGES_PER_DAY=10     # most new images per business per day

# Explainer videos with a voiceover (free to make; the voice is free or about 1 US cent). Used when the owner asks for an explainer, a walk-through or a voiceover.
# Needs the Python video setup above (.venv-codevideo with Pillow and numpy) and a sandbox (macOS or Linux with bubblewrap).
# PILOT_EXPLAINER_VIDEO=request    # request (default) | default (every free video) | off
# PILOT_VOICEOVER=auto             # auto (the free built-in voice where there is one) | openai (natural voice, about a cent per video) | system | off
