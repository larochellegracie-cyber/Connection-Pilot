# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# Development Tools
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# MySQL. Local: DB_*. On Railway use the MYSQL* variables (MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE) referenced from the MySQL service.
# DB_SSL=false only if the database does not support SSL.
# See DEPLOY_RAILWAY.md and run `npm run check:env`.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=user_<random>
# DB_PASS=<generated_password>
# DB_NAME=<schema_name>

# External APIs (when needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# FIRECRAWL_API_KEY=...

# Email (Resend). Without RESEND_API_KEY, emails are printed to the terminal
# in development. In production a missing key is an error.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=noreply@connectionpilot.net

# Authentication (when needed)
# BETTER_AUTH_SECRET=<random 32+ bytes>
# BETTER_AUTH_URL=http://localhost:5173
# BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.com

# Optional: a persistent folder (e.g. a Railway volume mount) where uploaded originals are kept.
# Without it, uploads still work: Pilot keeps the extracted text and findings in the database.
# PILOT_DOCUMENT_STORAGE_DIR=/data/pilot-documents
